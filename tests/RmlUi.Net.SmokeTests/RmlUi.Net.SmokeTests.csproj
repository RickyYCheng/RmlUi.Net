<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>RmlUi.Net.SmokeTests</AssemblyName>
    <RootNamespace>RmlUi.Net.SmokeTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\RmlUi.Net\RmlUi.Net.csproj" />
  </ItemGroup>

  <!-- DllImport probes the application directory first. Copy the native library for the
       current platform next to the executable so the smoke tests work with 'dotnet run'. -->
  <ItemGroup>
    <None Include="..\..\RmlUi.Net\runtimes\win-x64\native\RmlUiNative.dll"
          Link="RmlUiNative.dll"
          CopyToOutputDirectory="PreserveNewest"
          Condition="$([MSBuild]::IsOSPlatform('Windows')) and Exists('..\..\RmlUi.Net\runtimes\win-x64\native\RmlUiNative.dll')" />
    <None Include="..\..\RmlUi.Net\runtimes\linux-x64\native\libRmlUiNative.so"
          Link="libRmlUiNative.so"
          CopyToOutputDirectory="PreserveNewest"
          Condition="$([MSBuild]::IsOSPlatform('Linux')) and Exists('..\..\RmlUi.Net\runtimes\linux-x64\native\libRmlUiNative.so')" />
    <None Include="..\..\RmlUi.Net\runtimes\osx-x64\native\RmlUiNative.dylib"
          Link="RmlUiNative.dylib"
          CopyToOutputDirectory="PreserveNewest"
          Condition="$([MSBuild]::IsOSPlatform('OSX')) and Exists('..\..\RmlUi.Net\runtimes\osx-x64\native\RmlUiNative.dylib')" />
  </ItemGroup>

</Project>
