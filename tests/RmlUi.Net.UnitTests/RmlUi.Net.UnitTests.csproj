<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>RmlUi.Net.UnitTests</AssemblyName>
    <RootNamespace>RmlUi.Net.UnitTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\RmlUi.Net\RmlUi.Net.csproj" />
  </ItemGroup>

  <!-- The layout assertions need a font the test run controls: RmlUi collapses every
       content-sized box to zero when no font-family resolves (see KNOWN_ISSUES.md §1), so
       relying on a system font would make results machine-dependent. These Lato faces are
       shipped verbatim from RmlUi's samples under the SIL OFL; see assets/LICENSE.txt. -->
  <ItemGroup>
    <None Include="assets\*.ttf" Link="assets\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="assets\LICENSE.txt" Link="assets\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Import Project="../NativeTest.targets" />

</Project>
