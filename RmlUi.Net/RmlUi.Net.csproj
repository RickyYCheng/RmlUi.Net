<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DebugType>pdbonly</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <IsPackable>True</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <Title>RmlUi.Net (PourrezJ)</Title>
    <Product>RmlUi.Net</Product>
    <PackageId>PourrezJ.RmlUi.Net</PackageId>
    <Authors>PourrezJ</Authors>
    <Company>PourrezJ</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>C# bindings for RmlUi, maintained independently of the upstream RmlUi.Net package</Description>
    <RepositoryUrl>https://github.com/PourrezJ/RmlUi.Net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Version is fixed and explicit: bump it here for each release (and in CHANGELOG.md).
         Pack explicitly with 'dotnet pack' from the CI pipeline, which stages all native
         artifacts first. -->
    <VersionPrefix>1.1.0</VersionPrefix>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <GenerateAssemblyFileVersionAttribute>true</GenerateAssemblyFileVersionAttribute>
    <GenerateAssemblyInformationalVersionAttribute>true</GenerateAssemblyInformationalVersionAttribute>
    <GenerateAssemblyVersionAttribute>true</GenerateAssemblyVersionAttribute>
  </PropertyGroup>

  <PropertyGroup>
    <NoWarn>1701;1702;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <!-- Native artifacts per RID. The Condition keeps plain 'dotnet build' working when
         some platform artifacts have not been staged yet; the pack-time validation target
         below guarantees a published package always contains all four platforms. -->
    <Content Include="runtimes\win-x64\native\RmlUiNative.dll" Condition="Exists('runtimes\win-x64\native\RmlUiNative.dll')">
      <Pack>True</Pack>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <PackagePath>runtimes\win-x64\native\RmlUiNative.dll</PackagePath>
    </Content>
    <Content Include="runtimes\win-x86\native\RmlUiNative.dll" Condition="Exists('runtimes\win-x86\native\RmlUiNative.dll')">
      <Pack>True</Pack>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <PackagePath>runtimes\win-x86\native\RmlUiNative.dll</PackagePath>
    </Content>
    <Content Include="runtimes\linux-x64\native\libRmlUiNative.so" Condition="Exists('runtimes\linux-x64\native\libRmlUiNative.so')">
      <Pack>True</Pack>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <PackagePath>runtimes\linux-x64\native\libRmlUiNative.so</PackagePath>
    </Content>
    <Content Include="runtimes\osx-x64\native\RmlUiNative.dylib" Condition="Exists('runtimes\osx-x64\native\RmlUiNative.dylib')">
      <Pack>True</Pack>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <PackagePath>runtimes\osx-x64\native\RmlUiNative.dylib</PackagePath>
    </Content>
  </ItemGroup>

  <!-- Pack-time guard: a package must never be published without all four native artifacts.
       Set -p:SkipRuntimeArtifactValidation=true to pack a partial package locally; CI never does. -->
  <Target Name="ValidateRuntimeArtifacts" BeforeTargets="GenerateNuspec" Condition="'$(SkipRuntimeArtifactValidation)' != 'true'">
    <Error Condition="!Exists('runtimes\win-x64\native\RmlUiNative.dll')" Text="Missing native artifact: runtimes\win-x64\native\RmlUiNative.dll" />
    <Error Condition="!Exists('runtimes\win-x86\native\RmlUiNative.dll')" Text="Missing native artifact: runtimes\win-x86\native\RmlUiNative.dll" />
    <Error Condition="!Exists('runtimes\linux-x64\native\libRmlUiNative.so')" Text="Missing native artifact: runtimes\linux-x64\native\libRmlUiNative.so" />
    <Error Condition="!Exists('runtimes\osx-x64\native\RmlUiNative.dylib')" Text="Missing native artifact: runtimes\osx-x64\native\RmlUiNative.dylib" />
  </Target>

</Project>
