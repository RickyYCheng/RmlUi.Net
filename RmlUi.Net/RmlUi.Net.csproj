<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DebugType>pdbonly</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <IsPackable>True</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <Title>RmlUi.Net (RickyYC)</Title>
    <Product>RmlUi.Net</Product>
    <PackageId>RickyYC.RmlUi.Net</PackageId>
    <Authors>RickyYC</Authors>
    <Company>RickyYC</Company>
    <PackageLicenseFile>THIRD-PARTY-NOTICES.md</PackageLicenseFile>
    <Description>C# bindings for RmlUi, maintained independently of the upstream RmlUi.Net package</Description>
    <RepositoryUrl>https://github.com/RickyYCheng/RmlUi.Net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Version is fixed and explicit: bump it here for each release (and in CHANGELOG.md).
         Pack explicitly with 'dotnet pack' from the CI pipeline, which stages all native
         artifacts first. -->
    <VersionPrefix>1.3.0</VersionPrefix>
    <VersionSuffix>rc.1</VersionSuffix>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <GenerateAssemblyFileVersionAttribute>true</GenerateAssemblyFileVersionAttribute>
    <GenerateAssemblyInformationalVersionAttribute>true</GenerateAssemblyInformationalVersionAttribute>
    <GenerateAssemblyVersionAttribute>true</GenerateAssemblyVersionAttribute>
  </PropertyGroup>

  <PropertyGroup>
    <NoWarn>1701;1702;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="THIRD-PARTY-NOTICES.md" />
    <None Include="../LICENSE" Pack="true" PackagePath="licenses/RmlUi.Net/" />
    <None Include="../RmlUi.Native/ext/RmlUi/LICENSE.txt" Pack="true" PackagePath="licenses/RmlUi.txt" />
    <None Include="../RmlUi.Native/ext/RmlUi/Include/RmlUi/Core/Containers/LICENSE.txt" Pack="true" PackagePath="licenses/RmlUi-Containers.txt" />
    <None Include="../RmlUi.Native/ext/RmlUi/Source/Debugger/LICENSE.txt" Pack="true" PackagePath="licenses/RmlUi-Debugger-Fonts.txt" />
    <None Include="../RmlUi.Native/ext/freetype/docs/FTL.TXT" Pack="true" PackagePath="licenses/FreeType.txt" />
    <None Include="../RmlUi.Native/ext/freetype/src/bdf/README" Pack="true" PackagePath="licenses/FreeType-BDF/" />
    <None Include="../RmlUi.Native/ext/freetype/src/pcf/README" Pack="true" PackagePath="licenses/FreeType-PCF/" />
    <None Include="../RmlUi.Native/ext/freetype/src/gzip/zlib.h" Pack="true" PackagePath="licenses/FreeType-zlib.h" />
    <RuntimeLibrary Include="runtimes/win-x64/native/RmlUiNative.dll" />
    <RuntimeLibrary Include="runtimes/win-x86/native/RmlUiNative.dll" />
    <RuntimeLibrary Include="runtimes/linux-x64/native/libRmlUiNative.so" />
    <RuntimeLibrary Include="runtimes/osx-x64/native/RmlUiNative.dylib" />
    <RuntimeLibrary Include="runtimes/osx-arm64/native/RmlUiNative.dylib" />
    <None Update="@(RuntimeLibrary)" Pack="true" PackagePath="%(Identity)" />
  </ItemGroup>

  <Target Name="ValidateRuntimeArtifacts" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('%(RuntimeLibrary.FullPath)') And ('$(LocalPack)' != 'true' Or '$(ContinuousIntegrationBuild)' == 'true')"
           Text="Missing native library: %(RuntimeLibrary.Identity). Build it from this revision before packing." />
    <Error Condition="'$(LocalPack)' == 'true' And !$([System.String]::Copy('$(PackageVersion)').Contains('-local.'))"
           Text="Partial local packages require a version containing '-local.' and must not be published." />
  </Target>

</Project>
